# Secrets de la fonction `api` : supabase secrets set --env-file supabase/.env
# Ne jamais commiter le fichier .env.

# Modèle vision : toute API compatible OpenAI (/chat/completions).
# Par défaut : Gemma 4 chez Scaleway Generative APIs (clé à créer dans la console Scaleway, IAM → API keys).
VISION_API_BASE_URL=https://api.scaleway.ai/v1
VISION_API_KEY=
VISION_MODEL=gemma-4-26b-a4b-it
VISION_JSON_MODE=true
# Optionnel. « none » saute la phase de réflexion du modèle (environ 3 s au lieu de 7 à 27 s sur Gemma 4). Vide = le modèle réfléchit.
VISION_REASONING_EFFORT=none

OFF_USER_AGENT=Glu/0.1 (contact@example.com)
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT=30/minute
