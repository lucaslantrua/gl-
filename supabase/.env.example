# Secrets de la fonction `api` : supabase secrets set --env-file supabase/.env
# Ne jamais commiter le fichier .env.

# Modèle vision : toute API compatible OpenAI (/chat/completions).
# Réglage conseillé : Gemini (clé à créer dans Google AI Studio).
VISION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VISION_API_KEY=
# Identifiant exact à vérifier dans AI Studio : la gamme Flash-Lite est la moins chère, Flash la plus précise.
VISION_MODEL=gemini-3.5-flash-lite
VISION_JSON_MODE=true

OFF_USER_AGENT=Glu/0.1 (contact@example.com)
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT=30/minute
