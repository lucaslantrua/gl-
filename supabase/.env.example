# Secrets de la fonction `api` : supabase secrets set --env-file supabase/.env
# Ne jamais commiter le fichier .env.

# Modèle vision. "anthropic" (API Claude, sorties JSON garanties par schéma) ou "openai" (toute API compatible OpenAI).
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5
# Optionnel : low | medium | high. Plus bas = plus rapide et moins cher.
VISION_EFFORT=

# Mode compatible OpenAI (si VISION_PROVIDER=openai)
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_JSON_MODE=true

OFF_USER_AGENT=Glu/0.1 (contact@example.com)
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT=30/minute
