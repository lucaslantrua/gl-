VISION_API_BASE_URL=https://api.scaleway.ai/v1
VISION_API_KEY=
VISION_MODEL=gemma-4-26b-a4b-it
# Set to false if your OpenAI-compatible server rejects response_format=json_object
VISION_JSON_MODE=true
# Optional. "none" skips the model's reasoning phase (about 3 s instead of 7-27 s on Gemma 4). Leave empty to let it reason.
VISION_REASONING_EFFORT=none
OFF_USER_AGENT=Glu/0.1 (contact@example.com)
# Optional. Empty = in-memory LRU cache.
REDIS_URL=
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT=30/minute
